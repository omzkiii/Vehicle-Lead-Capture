generator client {
  provider      = "prisma-client"
  output        = "../src/generated/prisma"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String   @id @default(uuid())
  firstName           String
  lastName            String
  email               String   @unique
  phone               String
  vehicleOfInterestId String
  statusId            String
  dateReceived        DateTime @default(now())
  sourceId            String

  status            Status            @relation(fields: [statusId], references: [id])
  source            Source            @relation(fields: [sourceId], references: [id])
  vehicleOfInterest VehicleOfInterest @relation(fields: [vehicleOfInterestId], references: [id])

  @@index([dateReceived(sort: Desc)])
  @@index([vehicleOfInterestId, statusId, dateReceived])
  @@index([sourceId, statusId, dateReceived])
}

model Status {
  id    String @id @default(uuid())
  name  String @unique
  users User[]
}

model Source {
  id    String @id @default(uuid())
  name  String @unique
  users User[]
}

model VehicleOfInterest {
  id    String @id @default(uuid())
  name  String @unique
  users User[]
}
